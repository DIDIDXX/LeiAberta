FROM postgres:18-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/restore-venv \
    && /opt/restore-venv/bin/pip install --no-cache-dir boto3

WORKDIR /app
COPY scripts/restore_postgres_from_s3.py /app/restore_postgres_from_s3.py
ENV PATH="/opt/restore-venv/bin:${PATH}"
USER postgres
CMD ["sleep", "infinity"]
